<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>DucPham.XTL</PackageId>
    <Version>1.0.0</Version>
    <Authors>DucPham-it</Authors>
    <Description>Vietnamese number-to-text helpers (XTL.Utils).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/DucPham-it/my-csharp-first-try</RepositoryUrl>
    <PackageTags>vietnamese;number-to-text;xtl</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Check/**" />
    <None Remove="Check/**" />
  </ItemGroup>

</Project>
